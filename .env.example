# Primary business database
# PostgreSQL is the only relational business database in this project.
DATABASE_URL=postgresql+psycopg2:///pro_script_ai
POSTGRES_DB=pro_script_ai

# LLM routing
LLM_PROVIDER=google
LLM_FALLBACK_PROVIDER=deepseek
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# External trend search
TAVILY_API_KEY=

# Knowledge library / embedding runtime
HF_PUBLIC_BASE_URL=https://huggingface.co
COMPLIANCE_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
